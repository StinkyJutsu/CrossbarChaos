
<Window x:Class="CrossbarChaos.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crossbar Chaos Help"
        Width="700"
        Height="620"
        MinWidth="700"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="HelpHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#B8C6D6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
        </Style>
    </Window.Resources>

    <Border Background="#121820"
            BorderBrush="#304358"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Crossbar Chaos Help"
                               FontSize="23"
                               FontWeight="Bold"/>

                    <TextBlock Text="Setup, sound management, and troubleshooting"
                               FontSize="12"
                               Foreground="#AAB7C8"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Width="36"
                        Height="30"
                        Foreground="White"
                        Background="#304358"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Scrollable help content -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,22,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="12"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">

                                    <Border Background="Transparent"
                                            CornerRadius="6"
                                            Padding="3,2">

                                        <Track x:Name="PART_Track"
                                               IsDirectionReversed="True"
                                               Minimum="{TemplateBinding Minimum}"
                                               Maximum="{TemplateBinding Maximum}"
                                               ViewportSize="{TemplateBinding ViewportSize}"
                                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">

                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.DecreaseRepeatButton>

                                            <Track.Thumb>
                                                <Thumb MinHeight="36">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                                    Background="#506B85"
                                                                    CornerRadius="4"/>

                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="ThumbBorder"
                                                                            Property="Background"
                                                                            Value="#7895B0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>

                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                                              Opacity="0"
                                                              Focusable="False"/>
                                            </Track.IncreaseRepeatButton>

                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="0,0,12,0">

                    <TextBlock Text="Getting Started"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Crossbar Chaos plays random sounds when Rocket League reports a crossbar hit through its official Stats API. The application supports detected Steam and Epic installations. After initial configuration, either Rocket League or Crossbar Chaos can be launched first. If Rocket League was already running during initial setup, restart the game once for the API configuration to take effect."/>

                    <TextBlock Text="Sound Randomizer"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Enabled allows Crossbar Chaos to play sounds when crossbar events are detected. Disabled prevents automatic sound playback. The connection status indicates whether Rocket League's Stats API is currently connected. Enable the randomizer when you want sounds to play."/>

                    <TextBlock Text="Adding Individual Sounds"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Click Add Sounds to select one or more MP3 or WAV files. Imported sounds appear in the Sound Library and are enabled by default. Crossbar Chaos does not include any preinstalled sounds."/>

                    <TextBlock Text="Adding Sound Folders"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Click Add Folder to select one or more directories containing sounds. Supported audio files in those directories and their subfolders are added to the library. Registered folder locations are saved so they can be scanned again later."/>

                    <TextBlock Text="Refresh List"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Click Refresh List to scan every registered sound folder and its subfolders for new MP3 and WAV files. Newly discovered sounds are imported without requiring you to select each folder again. Existing sounds are retained. Sounds manually removed from the library can return after refreshing if their files are still inside a registered folder."/>

                    <TextBlock Text="Searching the Sound Library"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Use the search box at the top-right of the Sound Library to filter sounds by filename. The total sounds counter shows the number of sounds in the library. Searching does not change which sounds are eligible for random playback."/>

                    <TextBlock Text="Individual Sound Volume"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Each sound has its own volume slider from 0% to 200%. The default is 100%. Above 100%, the slider turns red to indicate amplification. Amplification may cause clipping or distortion, depending on the audio file. Adjust each sound individually to balance naturally quiet and loud recordings."/>

                    <TextBlock Text="Impact-Based Volume"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Automatic playback volume varies continuously according to the ball speed reported during a crossbar hit. Softer hits use a lower percentage of the selected sound's baseline volume, while harder hits approach 100% of that baseline. For example, a sound set to 150% can play at a lower effective volume on a soft impact and reach 150% on a sufficiently hard impact. Test Sound uses the full selected baseline volume."/>

                    <TextBlock Text="Enabled Sounds and Random Selection"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Use each sound's Enabled checkbox to include or exclude it from random playback. Crossbar Chaos selects from enabled sounds using a session-based shuffle system to reduce immediate repeats. Multiple sounds may overlap when separate crossbar hits occur close together."/>

                    <TextBlock Text="Remove Selected and Test Sound"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Select a sound and click Remove Selected to remove its entry from Crossbar Chaos. This does not delete the original audio file from your computer. Select a sound and click Test Sound to hear it through your selected audio output device."/>

                    <TextBlock Text="Audio Output"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Choose the Windows audio playback device where Crossbar Chaos should send its sounds. This can be a headset, speakers, or a virtual audio device. Your selected output is saved and used for both Test Sound and automatic playback."/>

                    <TextBlock Text="Important: Keep Audio Files in Place"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Crossbar Chaos references sound files at their existing locations rather than copying them into the application. Moving, renaming, or deleting an imported file can prevent it from playing. If you relocate sounds, remove the broken entries and add the files again from their new location. Keep registered folders accessible."/>

                    <TextBlock Text="Troubleshooting"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="If sounds are not playing, verify that the randomizer is enabled, Rocket League is connected, at least one valid sound is enabled, and the correct audio output device is selected. If Refresh List does not discover a file, confirm that its folder was added through Add Folder and that the file has an MP3 or WAV extension. If the Stats API was configured while Rocket League was running, restart Rocket League."/>

                    <TextBlock Text="Closing and Uninstalling"
                               Style="{StaticResource HelpHeading}"/>

                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Closing Crossbar Chaos stops its event listener but leaves the configured Rocket League Stats API settings in place. Uninstallation attempts to restore the original API configuration. If restoration fails, the uninstaller displays a warning and continues."/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
